PROJECT_NAME           = "Apollo-Lite"
PROJECT_BRIEF          = "Low-speed autonomous-driving integration"
OUTPUT_DIRECTORY       = .cache/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = README.md \
                         README.zh-cn.md \
                         AGENTS.md \
                         docs \
                         products \
                         scripts \
                         tools
FILE_PATTERNS          = *.md *.py *.sh *.cc *.h *.bzl
RECURSIVE              = YES
EXCLUDE                = .git \
                         .cache \
                         ad_agents \
                         pkgs \
                         bazel-bin \
                         bazel-out \
                         bazel-testlogs
EXCLUDE_PATTERNS       = */__pycache__/* */tests/*
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
