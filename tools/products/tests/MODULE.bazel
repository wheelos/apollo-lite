module(name = "apollo_product_tests")

bazel_dep(name = "wheelos_core", version = "1.0.6", repo_name = "core")
bazel_dep(name = "wheelos_msgs", version = "0.1.6")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.4.1")

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "apollo_products",
    path = "../../..",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)
