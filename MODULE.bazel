module(
    name = "apollo",
    version = "8.0.0",
)

# Bazel rules and toolchains
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.4.1")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

# WheelOS foundation and product capability modules
bazel_dep(name = "wheelos_core", version = "1.0.6", repo_name = "core")
bazel_dep(name = "wheelos_common", version = "0.1.3.bcr.1")
bazel_dep(name = "wheelos_transform", version = "0.1.0")
bazel_dep(name = "wheelos_localization", version = "0.1.0")
bazel_dep(name = "wheelos_lidar_perception", version = "0.1.0")
bazel_dep(name = "wheelos_camera_perception", version = "0.1.0")
bazel_dep(name = "wheelos_multimodal_perception", version = "0.1.0")
bazel_dep(name = "wheelos_prediction", version = "0.1.0")
bazel_dep(name = "wheelos_routing", version = "0.1.0")
bazel_dep(name = "wheelos_mission", version = "0.1.0")
bazel_dep(name = "wheelos_planning", version = "0.1.0")
bazel_dep(name = "wheelos_control", version = "0.1.0")
bazel_dep(name = "wheelos_safety", version = "0.1.0")
bazel_dep(name = "wheelos_hmi", version = "0.1.0")
bazel_dep(name = "wheelos_perception", version = "0.1.0")
bazel_dep(name = "wheelos_world_model", version = "0.1.0")
bazel_dep(name = "wheelos_simulation", version = "0.1.0")
bazel_dep(name = "wheelos_tool_kit", version = "0.1.0")

# Hardware modules; each owns its driver SDK dependencies
bazel_dep(name = "hardware.audio", version = "0.1.0")
bazel_dep(name = "hardware.build", version = "0.1.0")
bazel_dep(name = "hardware.camera", version = "0.1.0")
bazel_dep(name = "hardware.camera_gst", version = "0.1.0")
bazel_dep(name = "hardware.canbus", version = "0.1.0")
bazel_dep(name = "hardware.gnss", version = "0.1.0")
bazel_dep(name = "hardware.hal", version = "0.1.0")
bazel_dep(name = "hardware.image_decompress", version = "0.1.0")
bazel_dep(name = "hardware.lidar", version = "0.1.0")
bazel_dep(name = "hardware.radar", version = "0.1.0")
bazel_dep(name = "hardware.vehicle", version = "0.1.0")
bazel_dep(name = "hardware.video", version = "0.1.0")

# Root-only overrides
# Keep the graph on 10.0.0; without this override MVS selects 11.0.0.
single_version_override(
    module_name = "tinyxml2",
    version = "10.0.0",
)
