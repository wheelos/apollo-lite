module(
    name = "apollo",
    version = "8.0.0",
    compatibility_level = 1,
)

# bazel
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_pkg", version = "0.10.1")
bazel_dep(name = "rules_proto", version = "6.0.2")
bazel_dep(name = "rules_python", version = "0.34.0")
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)
use_repo(cuda, "cuda")

bazel_dep(name = "platforms", version = "0.0.10")

cudnn_ext = use_extension("//third_party/cudnn:extensions.bzl", "cudnn")
use_repo(cudnn_ext, "local_config_cudnn")

tensorrt_ext = use_extension("//third_party/tensorrt:extensions.bzl", "tensorrt_configure")
use_repo(tensorrt_ext, "local_config_tensorrt")

ffmpeg_ext = use_extension("//third_party/ffmpeg:extensions.bzl", "ffmpeg")

qt_ext = use_extension("//third_party/qt5:extensions.bzl", "qt")

libtorch_ext = use_extension("//third_party/libtorch:extensions.bzl", "libtorch_ext")
use_repo(libtorch_ext, "libtorch_cpu", "libtorch_gpu")

gstreamer_ext = use_extension("//third_party/gstreamer:extensions.bzl", "gstreamer")
use_repo(gstreamer_ext, "gstreamer")

use_repo(ffmpeg_ext, "ffmpeg")

use_repo(qt_ext, "qt")

# TODO: Keep the version of Python toolchain consistent with Docker.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.10")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

