# Use through scripts/bzlmod.py registry to exclude other rc files.
import %workspace%/.bazelrc.common
common --registry=file://%workspace%/pkgs/bazel-central-registry
common --registry=https://bcr.wheelos.cn/
common --registry=https://bcr.bazel.build/
common --lockfile_mode=off
common --announce_rc
test --flaky_test_attempts=1
test --test_size_filters=
