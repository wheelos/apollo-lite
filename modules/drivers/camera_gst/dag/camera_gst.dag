# Define camera_gst component.
module_config {
  module_library: "bazel-bin/modules/drivers/camera_gst/libcamera_gst_component.so"

  components {
    class_name: "CameraGstComponent"
    config {
      name: "camera_gst"
      config_file_path: "modules/drivers/camera_gst/conf/camera_gst_demo.pb.txt"
    }
  }
}
