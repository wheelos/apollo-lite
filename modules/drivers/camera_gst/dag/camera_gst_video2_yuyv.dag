# Define one camera_gst component for /dev/video2 benchmark (YUYV publish).
module_config {
  module_library: "/apollo/bazel-bin/modules/drivers/camera_gst/libcamera_gst_component.so"

  components {
    class_name: "CameraGstComponent"
    config {
      name: "camera_gst_video2_yuyv"
      config_file_path: "/apollo/modules/drivers/camera_gst/conf/camera_gst_video2_yuyv.pb.txt"
    }
  }
}
