# GPU-to-CPU appsink readback benchmark with no Cyber channel publishing.
module_config {
  module_library: "/apollo/bazel-bin/modules/drivers/camera_gst/libcamera_gst_component.so"

  components {
    class_name: "CameraGstComponent"
    config {
      name: "camera_gst_video2_rgb_readback"
      config_file_path: "/apollo/modules/drivers/camera_gst/conf/camera_gst_video2_rgb_readback.pb.txt"
    }
  }
}
