module_config {
  module_library : "bazel-bin/modules/perception/onboard/component/libperception_component_camera.so"
  components {
    class_name : "CameraBevDetectionComponent"
    config {
      name: "CameraBevDetectionComponent"
      config_file_path: "modules/perception/production/conf/perception/camera/bev_camera_detection_component.pb.txt"
      flag_file_path: "modules/perception/production/conf/perception/perception_common.flag"
      readers {
        channel: "/apollo/sensor/camera/CAM_BACK/image"
      }
    }
  }
}