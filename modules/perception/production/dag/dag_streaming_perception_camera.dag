module_config {
  module_library : "bazel-bin/modules/perception/onboard/component/libperception_component_camera.so"
  components {
    class_name : "CameraObstacleDetectionComponent"
    config {
      name: "Camera6mmObstacleDetectionComponent"
      config_file_path: "modules/perception/production/conf/perception/camera/fusion_camera_detection_component.pb.txt"
      flag_file_path: "modules/perception/production/conf/perception/perception_common.flag"
    }
  }
  
  components {
    class_name : "CameraObstacleDetectionComponent"
    config {
      name: "Camera12mmObstacleDetectionComponent"
      config_file_path: "modules/perception/production/conf/perception/camera/fusion_camera_detection_component.pb.txt"
      flag_file_path: "modules/perception/production/conf/perception/perception_common.flag"
    }
  }
}
