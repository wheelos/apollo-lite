<root BTCPP_format="4">
    <BehaviorTree ID="PatrolTask">
        <Repeat num_cycles="-1">
            <Sequence name="RouteSequence">
                <Action ID="MoveTo" goal="{Station_A}" />
                <Action ID="StationWait" seconds="5.0" />
                <Action ID="MoveTo" goal="{Station_B}" />
                <Action ID="StationWait" seconds="5.0" />
            </Sequence>
        </Repeat>
    </BehaviorTree>
</root>
