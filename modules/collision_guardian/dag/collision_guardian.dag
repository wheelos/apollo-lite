module_config {
  module_library: "bazel-bin/modules/collision_guardian/libcollision_guardian_component.so"
  timer_components {
    class_name: "CollisionGuardianComponent"
    config {
      name: "collision_guardian"
      config_file_path: "modules/collision_guardian/conf/collision_guardian.pb.txt"
      interval: 50
    }
  }
}
