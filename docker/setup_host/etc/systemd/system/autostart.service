[Unit]
Description=WheelOS Autonomous Driving System Autostart Service
Documentation=https://www.wheelos.cn/
After=network.target docker.service
Requires=docker.service

[Service]
# --- Identity & Security ---
# These placeholders will be replaced by the installation script.
# Running as the specific user ensures file permissions in the mapped volumes remain correct.
User=__USER__
Group=__GROUP__
WorkingDirectory=__APOLLO_ROOT_DIR__

# --- Environment ---
# Docker Compose sometimes needs HOME to find .docker/config.json or similar
Environment="HOME=__HOME_DIR__"
# Ensure the script can find standard tools
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# --- Service Behavior ---
# Type=oneshot is perfect for "docker compose up -d" because the command returns
# immediately after telling the daemon to start the containers.
Type=oneshot
RemainAfterExit=yes

# --- Commands ---
# We delegate the complexity of architecture detection and env generation to the 'whl' script.
# The 'start' command in 'whl' script handles 'docker compose up -d'.
ExecStart=/bin/bash __APOLLO_ROOT_DIR__/whl start

# The 'stop' command handles 'docker compose down'.
ExecStop=/bin/bash __APOLLO_ROOT_DIR__/whl stop

# --- Resiliency ---
# If the whl script itself fails (exit code != 0), wait and retry.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
