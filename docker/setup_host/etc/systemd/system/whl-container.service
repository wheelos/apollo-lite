[Unit]
Description=WheelOS Apollo container lifecycle
Documentation=https://www.wheelos.cn/
After=network.target docker.service
Requires=docker.service

[Service]
# --- Identity & Security ---
# These placeholders will be replaced by the installation script.
# Running as the specific user ensures file permissions in the mapped volumes remain correct.
User=__USER__
Group=__GROUP__
WorkingDirectory=__APOLLO_ROOT_DIR__

# --- Environment ---
# HOME is set so docker can find user docker configs.
Environment="HOME=__HOME_DIR__"
# Ensure the script can find standard tools
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# --- Service Behavior ---
# The unit manages the production container lifecycle only.
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120s
TimeoutStopSec=60s

# --- Commands ---
# We delegate the complexity of architecture detection and env generation to the 'whl' script.
# The 'start' command in 'whl' script handles 'docker compose up -d'.
ExecStart=/bin/bash __APOLLO_ROOT_DIR__/docker/scripts/whl.sh start prod

# Stop preserves the container so a later start can reuse it.
ExecStop=/bin/bash __APOLLO_ROOT_DIR__/docker/scripts/whl.sh stop prod

[Install]
WantedBy=multi-user.target
