# Release-consumer validation; scripts/bzlmod.py isolates it from user/dev rc.
import %workspace%/.bazelrc.common
common --registry=https://bcr.wheelos.cn/
common --registry=https://bcr.bazel.build/
common --lockfile_mode=error
common --announce_rc
test --flaky_test_attempts=1
test --test_size_filters=
